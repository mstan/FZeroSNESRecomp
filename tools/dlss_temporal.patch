@@ -787,6 +795,26 @@ __declspec(dllexport) int __cdecl dlss5nr_process(
             CopyError(err, err_cap);
             return 0;
         }
+        if (flow.has_flow) {
+            double sx = 0, sy = 0, magnitude = 0, nonzero = 0, count = 0;
+            for (uint32_t y = flow.height / 4; y < flow.height * 3 / 4; ++y) {
+                for (uint32_t x = flow.width / 4; x < flow.width * 3 / 4; ++x) {
+                    size_t i = (static_cast<size_t>(y) * flow.width + x) * 2;
+                    float dx = flow.xy[i] / 32.0f, dy = flow.xy[i + 1] / 32.0f;
+                    sx += dx; sy += dy;
+                    magnitude += std::abs(dx) + std::abs(dy);
+                    nonzero += dx != 0 || dy != 0;
+                    ++count;
+                }
+            }
+            if (count) {
+                g_motion_stats[0] = static_cast<float>(sx / count);
+                g_motion_stats[1] = static_cast<float>(sy / count);
+                g_motion_stats[2] = static_cast<float>(magnitude / count);
+                g_motion_stats[3] = static_cast<float>(nonzero / count);
+            }
+            g_motion_stats[4] = 1;
+        }
     }
 
     SetCommonParams(style, preset, intensity, tone, structure, skin, automask, reset ? 1 : 0, use_motion_vectors);
