# Root-level CMake build trees and release staging.
/build*/
/FZeroSNESRecomp/
/release-stage/
/release-linux/
/release-macos*/

# ROM files (copyrighted; never commit or redistribute).
*.smc
*.sfc
*.fig
*.rom

# Recompiler output and other ROM-derived generated data.
src/gen/
assets/*
!assets/README.md
!assets/img/
assets/img/*
!assets/img/boxart.tga
!assets/shaders/
!assets/shaders/**
!assets/track-packs/
!assets/track-packs/*.ini
/track-packs/
/tier2_coverage.json
/tier2_*.json
/tier2_*.jsonl

# Runtime save/config/crash artifacts.
/saves/
*.sav
*.srm
/rom.cfg
/keybinds.ini
/config.ini
/fzero-video.ini
/fzero-video.ini.tmp
/diagnostics/
/last_run_report.json
/crash_report_*.json
/crash_minidump_*.dmp

# Local captures and triage scratch. Curated README assets belong in docs/.
*.wav
*.ppm
*.bmp
*.png
!docs/
!docs/screenshots/
!docs/screenshots/*.png
captures/
snesref_trace.jsonl
_*
!assets/shaders/_passes/
!assets/shaders/_passes/**

# Compiler, IDE, and OS artifacts.
*.obj
*.pdb
*.ilk
*.exe
*.dll
*.tlog
*.log
*.idb
.vs/
*.vcxproj.user
Thumbs.db
.DS_Store

# Python caches.
__pycache__/
*.pyc

# Ghidra databases are local and regenerable; track exported annotations only.
ghidra/*
!ghidra/annotations/
!ghidra/annotations/**
*.gpr
*.rep/
*.lock
*.lock~

# User-owned course payloads and local configuration.
/mods/track-packs/
